{
  "name": "ryu-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "validate:urls": "node --import tsx src/validateUrls.ts",
    "export:public": "node --import tsx src/exportPublicBootstrap.ts",
    "start": "node --import tsx src/server.ts",
    "import:inventory": "node --import tsx src/importInventory.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
